{
    "openapi": "3.1.0",
    "info": {
        "title": "Predictily Engine",
        "description": "Motor predictivo interno de Predictily. Solo accesible desde la red interna (Bearer token).",
        "version": "0.1.0"
    },
    "paths": {
        "/health": {
