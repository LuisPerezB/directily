    "components": {
        "schemas": {
            "EvaluateRequest": {
                "properties": {
                    "training_job_id": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Training Job Id"
                    },
                    "lookback_runs": {
                        "type": "integer",
                        "maximum": 50.0,
                        "minimum": 1.0,
                        "title": "Lookback Runs",
                        "default": 10
                    }
                },
                "type": "object",
                "title": "EvaluateRequest"
            },
            "ExecuteOptions": {
                "properties": {
                    "force_models": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Force Models"
                    },
                    "max_backtest_windows": {
                        "anyOf": [
                            {
                                "type": "integer",
                                "maximum": 6.0,
                                "minimum": 1.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Max Backtest Windows"
                    },
                    "seed": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Seed"
                    }
                },
                "type": "object",
                "title": "ExecuteOptions"
            },
            "ExecuteRequest": {
                "properties": {
                    "tenant_id": {
                        "type": "integer",
                        "exclusiveMinimum": 0.0,
                        "title": "Tenant Id"
                    },
                    "training_job_id": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Training Job Id"
                    },
                    "horizons": {
                        "items": {
                            "type": "integer"
                        },
                        "type": "array",
                        "title": "Horizons"
                    },
                    "cutoff_date": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Cutoff Date"
                    },
                    "options": {
                        "$ref": "#/components/schemas/ExecuteOptions"
                    }
                },
                "type": "object",
                "required": [
                    "tenant_id"
                ],
                "title": "ExecuteRequest"
            },
            "ExecuteResponse": {
                "properties": {
                    "run_id": {
                        "type": "integer",
                        "title": "Run Id"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "series_count": {
                        "type": "integer",
                        "title": "Series Count"
                    },
                    "cutoff_date": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Cutoff Date"
                    },
                    "selection": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Selection"
                    },
                    "metrics": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Metrics"
                    },
                    "warnings": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Warnings"
                    },
                    "duration_ms": {
                        "type": "integer",
                        "title": "Duration Ms"
                    }
                },
                "type": "object",
                "required": [
                    "run_id",
                    "status",
                    "series_count",
                    "cutoff_date",
                    "selection",
                    "metrics",
                    "warnings",
                    "duration_ms"
                ],
                "title": "ExecuteResponse"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ReadinessRequest": {
                "properties": {
                    "training_job_id": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Training Job Id"
                    }
                },
                "type": "object",
                "title": "ReadinessRequest"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
