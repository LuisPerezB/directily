# Configuración de la landing. TODO se define aquí y se lee al levantar o compilar:
# copie este archivo a .env, complete los valores y ejecute `npm run dev` o `npm run build`.
# La página es solo frontend: no necesita el backend para funcionar.

# ── Contacto ──────────────────────────────────────────────────────────────────
# A dónde llegan las solicitudes. El formulario arma el mensaje y abre el correo o el
# WhatsApp de la persona con todo escrito. Defina al menos uno antes de publicar.
VITE_CONTACT_EMAIL=
# Con código de país y solo dígitos, p. ej. 5939XXXXXXXX.
VITE_CONTACT_WHATSAPP=

# ── Página ────────────────────────────────────────────────────────────────────
# Idioma de quien llega sin preferencia: es | en. Vacío = el idioma de su navegador.
VITE_DEFAULT_LANG=
# URL de la aplicación; con ella aparece el enlace «Iniciar sesión» (se le agrega /login).
VITE_APP_URL=
# Dirección pública del sitio, sin barra final (p. ej. https://www.su-dominio.com). La usan las
# redes y la mensajería para mostrar la imagen al compartir el enlace.
VITE_SITE_URL=
# Carpeta o URL del video y su portada. Vacío = la carpeta media/ que acompaña a index.html.
VITE_MEDIA_BASE_URL=
# Código de verificación de Google Search Console (método «Etiqueta HTML»): pegue SOLO el valor de content="…".
VITE_GOOGLE_SITE_VERIFICATION=
# Puerto del servidor de desarrollo y de `npm run preview`.
VITE_DEV_PORT=5174

# ── Opcional: guardar las solicitudes en el backend ───────────────────────────
# Solo si algún día quiere que el formulario envíe a la API en vez de abrir correo/WhatsApp:
# URL completa de POST /api/v1/contact-requests (el backend debe permitir el dominio en CORS).
VITE_CONTACT_API_URL=
