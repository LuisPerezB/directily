.DS_Store
.idea/
.vscode/
*.log
.env
!.env.example
# backend
backend/vendor/
backend/node_modules/
backend/storage/*.key
# engine
engine/.venv/
engine/**/__pycache__/
engine/.pytest_cache/
engine/storage/artifacts/
engine/.ruff_cache/
engine/.mypy_cache/
# mcp (servidores MCP: siembra y análisis)
mcp/.venv/
mcp/**/__pycache__/
mcp/.pytest_cache/
mcp/build/
mcp/src/*.egg-info/
# frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
engine/build/
engine/*.egg-info/
# Variantes locales de entorno (contienen claves): nunca se versionan.
.env.*
!.env.example
# Datos y resultados del piloto con datos REALES de clientes (repositorio público): nunca se versionan
# sin autorización expresa del propietario (docs/operations/PILOT_RUNBOOK.md §0).
reports/private/
data/private/
# infra/aws (AWS CDK, V2.5 W4-C): dependencias, salida de síntesis y datos locales del propietario (cuenta, dominios; sin secretos).
infra/aws/node_modules/
infra/aws/cdk.out/
infra/aws/cdk.context.json
infra/aws/owner-inputs.*.json
!infra/aws/owner-inputs.example.json

# landing (React, página pública independiente)
landing/node_modules/
landing/dist/
