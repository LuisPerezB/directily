# Motor predictivo de Predictily (prefijo ENGINE_)
ENGINE_DATABASE_URL=postgresql+psycopg://predictily:secret@127.0.0.1:5432/predictily
# Debe coincidir con ENGINE_API_TOKEN del backend Laravel. Cambiar en producción.
ENGINE_API_TOKEN=dev-engine-token-change-me
ENGINE_ARTIFACTS_DIR=./storage/artifacts
ENGINE_RANDOM_SEED=42
ENGINE_LOG_LEVEL=INFO
ENGINE_N_JOBS=4
# Límite de seguridad: con más series no se entrena LightGBM global
ENGINE_MAX_SERIES_LGBM=5000
# Un run "running" más antiguo que esto se considera abandonado (reintento del Job de Laravel)
ENGINE_STALE_RUN_SECONDS=1800
# Mejora relativa mínima de WAPE que debe lograr un modelo complejo frente al mejor estadístico
ENGINE_MIN_IMPROVEMENT=0.03
ENGINE_MAX_BACKTEST_WINDOWS=3
