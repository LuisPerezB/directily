# Motor predictivo de Predictily (prefijo ENGINE_)
ENGINE_DATABASE_URL=postgresql+psycopg://predictily:secret@127.0.0.1:5432/predictily
# Debe coincidir con ENGINE_API_TOKEN del backend Laravel. Cambiar en producción.
ENGINE_API_TOKEN=dev-engine-token-change-me
ENGINE_ARTIFACTS_DIR=./storage/artifacts
ENGINE_RANDOM_SEED=42
ENGINE_LOG_LEVEL=INFO
ENGINE_N_JOBS=4
# Límite de seguridad: con más series no se entrena LightGBM global
ENGINE_MAX_SERIES_LGBM=5000
# Un run "running" más antiguo que esto se considera abandonado (reintento del Job de Laravel)
ENGINE_STALE_RUN_SECONDS=1800
# Sobrescrituras del OPERADOR (etapa 2): déjelas comentadas. Sin definir, manda la configuración por core, perfil sectorial y empresa
# (ADR-V2-06; demand.min_improvement = 0,03 y demand.max_backtest_windows = 3 por defecto). Si las define, anulan esa configuración
# para TODAS las empresas y quedan registradas en effective_config.run.
# Mejora relativa mínima de WAPE que debe lograr un modelo complejo frente al mejor estadístico
# ENGINE_MIN_IMPROVEMENT=0.03
# ENGINE_MAX_BACKTEST_WINDOWS=3

# ── Firma Ed25519 de artefactos de modelos (ADR-V25-20; platform/signing.py; docs/ml/MODEL_REGISTRY.md) ──
# El serving verifica firma, SHA-256, tamaño y empresa ANTES de deserializar (joblib/pickle). Sin firma válida el artefacto no se carga:
# el motor usa su respaldo (referencia validada / reajuste estadístico) y lo marca en `limitations`.
# Genere el par con:  python -m predictily_engine.cli keygen --key-id k-2026-11 --private-out /ruta/segura/firma.key
# Lado de ENTRENAMIENTO (entorno autorizado a firmar). La privada NUNCA va a un repositorio ni al serving:
# ENGINE_SIGNING_KEY_ID=
# ENGINE_SIGNING_PRIVATE_KEY=file:/run/secrets/engine_signing_key     # semilla Ed25519 de 32 bytes en base64, o file:<ruta>
# Lado de SERVICIO (motor que carga artefactos; el backend usa la misma variable): `kid:clave` pública, separadas por comas
# ENGINE_TRUSTED_PUBLIC_KEYS=
# Legado: acepta artefactos SIN firma (verificables solo por SHA-256). Por defecto false; solo en un entorno local. Nunca acepta firmas inválidas.
# ENGINE_ALLOW_UNSIGNED_ARTIFACTS=false

# ── Almacén de objetos y entrenamiento privado por empresa (W4-B; platform/object_store.py; docs/ml/PRIVATE_TENANT_TRAINING.md) ──
# `publish` sube el artefacto firmado a tenants/<uuid de la empresa>/models/<core>/<versión>/… (clave generada por el servidor) y lo registra como candidate.
# Controlador local (desarrollo): la raíz DEBE ser la del disco que lee el backend (PREDICTILY_MODELS_DISK; en el monorepo, backend/storage/app/private).
# ENGINE_OBJECT_STORE_DRIVER=local
# ENGINE_OBJECT_STORE_ROOT=/ruta/al/disco/local/del/backend
# Controlador S3 (extra opcional «s3»: pip install 'predictily-engine[s3]'). Las credenciales NO van aquí: las resuelve la cadena estándar de boto3 (rol de tarea).
# ENGINE_OBJECT_STORE_DRIVER=s3
# ENGINE_OBJECT_STORE_BUCKET=
# ENGINE_OBJECT_STORE_REGION=
# ENGINE_OBJECT_STORE_ENDPOINT=              # solo un emulador S3 (moto, MinIO)
# ENGINE_OBJECT_STORE_PATH_STYLE=false
# ENGINE_OBJECT_STORE_SSE=aws:kms            # AES256 | aws:kms
# ENGINE_OBJECT_STORE_KMS_KEY_ID=
# Caché de artefactos ya verificados y deserializados (clave: empresa + versión + esquema + SHA-256); 0 la desactiva.
# ENGINE_ARTIFACT_CACHE_ENTRIES=32
