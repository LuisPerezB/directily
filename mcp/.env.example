# Servidores MCP de Predictily (mcp/). Copie a .env.local o defina estas variables en la configuración de su cliente MCP.
# Ningún valor real se versiona: .env.* está ignorado por git.

# ── API de Predictily (obligatorio) ─────────────────────────────────────────────────────────────────────────────
# Debe incluir /api/v1. http solo se acepta hacia el propio equipo; hacia otro host use https
# (o PREDICTILY_API_ALLOW_INSECURE_HTTP=true si la red ya está cifrada, p. ej. una VPN).
PREDICTILY_API_URL=http://127.0.0.1:8000/api/v1
# Token personal de la persona (Seguridad → Tokens, o POST /api/v1/auth/tokens): ligado a UNA empresa, con las
# habilidades mínimas y con caducidad. Solo en modo stdio; en modo http cada persona lo envía en su cabecera.
PREDICTILY_API_TOKEN=
# Solo si el token NO está ligado a una empresa: uuid de la empresa activa.
# PREDICTILY_TENANT_ID=
# PREDICTILY_API_TIMEOUT=60
# PREDICTILY_API_VERIFY_TLS=true

# ── Políticas del servidor (los valores por defecto son los más reservados) ─────────────────────────────────────
# Aprobaciones (mapeos, plantillas, confirmar importaciones): elicit = la persona confirma en su cliente MCP;
# deny = solo en la aplicación; allow = el agente aprueba directamente (decisión de quien opera el servidor).
# PREDICTILY_MCP_APPROVALS=elicit
# Filas del sistema del cliente hacia el modelo: shapes = solo la forma de los valores; full = los valores.
# PREDICTILY_MCP_ROW_SAMPLES=shapes
# Herramientas de análisis por cliente (códigos de comprador): apagadas por defecto.
# PREDICTILY_MCP_CUSTOMER_TOOLS=false
# Tamaño máximo (caracteres) de una respuesta hacia el modelo.
# PREDICTILY_MCP_MAX_RESULT_CHARS=20000

# ── Solo servidor de siembra ────────────────────────────────────────────────────────────────────────────────────
# Carpeta con los CSV/XLSX exportados del sistema del cliente. Sin ella, la carga de archivos queda desactivada.
# PREDICTILY_MCP_IMPORT_DIR=
# Perfiles de conexión a la base del cliente: las credenciales viven AQUÍ, nunca en el chat.
# PREDICTILY_SOURCE_ERP_CONNECTOR=sql_sqlserver
# PREDICTILY_SOURCE_ERP_HOST=
# PREDICTILY_SOURCE_ERP_PORT=1433
# PREDICTILY_SOURCE_ERP_DATABASE=
# PREDICTILY_SOURCE_ERP_USERNAME=
# PREDICTILY_SOURCE_ERP_PASSWORD=
# PREDICTILY_SOURCE_ERP_TRUST_SERVER_CERTIFICATE=true
# …o un archivo JSON fuera del repositorio (chmod 600): {"erp": {"username": "…", "password": "…", …}}
# PREDICTILY_MCP_SOURCE_PROFILES=
