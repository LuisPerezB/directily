AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8080
ENGINE_URL=http://127.0.0.1:8811
ENGINE_API_TOKEN=e2e-token-p1
ENGINE_TIMEOUT=900

SUPERADMIN_EMAIL=admin@predictily.test
SUPERADMIN_PASSWORD=CambiarEsto2026

# Mayor que el timeout del Job más largo (RunForecastPipeline ~ ENGINE_TIMEOUT + margen):
# si no, Redis re-entrega el trabajo mientras aún corre.
REDIS_QUEUE_RETRY_AFTER=1020
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
