# ── Predictily · backend (Laravel 13) ──────────────────────────────────────
APP_NAME=Predictily
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL 16
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=predictily
DB_USERNAME=predictily
DB_PASSWORD=secret

# Redis 7: sesiones, caché y colas (default, imports, forecasting)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Debe superar el timeout del Job más largo (RunForecastPipeline ≈ ENGINE_TIMEOUT + margen),
# si no Redis re-entrega el trabajo mientras aún se ejecuta.
REDIS_QUEUE_RETRY_AFTER=1020

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# SPA (Sanctum: cookies de sesión + CSRF). En producción usar el dominio real.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# Motor predictivo interno (FastAPI)
ENGINE_URL=http://127.0.0.1:8100
ENGINE_API_TOKEN=cambie-este-token-compartido
ENGINE_TIMEOUT=900

# Superadministrador de plataforma (lo crea `php artisan db:seed`)
SUPERADMIN_EMAIL=admin@predictily.test
SUPERADMIN_PASSWORD=

# Predictily
PREDICTILY_DEFAULT_PLAN=trial
PREDICTILY_IMPORT_MAX_KB=20480
PREDICTILY_AUDIT_RETENTION_DAYS=730
# Ruta de los datasets ficticios de demostración (por defecto ../data/demo)
# PREDICTILY_DEMO_PATH=/var/www/data/demo
