# ── Predictily · backend (Laravel 13) ──────────────────────────────────────
APP_NAME=Predictily
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# Alertas operativas (config/ops.php): siempre van al log como CRITICAL; opcionalmente también a otro canal (p. ej. slack).
OPS_ALERT_LOG_CHANNEL=
OPS_ALERT_THROTTLE_SECONDS=900
LOG_SLACK_WEBHOOK_URL=

# PostgreSQL 16
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=predictily
DB_USERNAME=predictily
DB_PASSWORD=secret

# Redis 7: sesiones, caché y colas (default, imports, forecasting)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Debe superar el timeout del Job más largo (RunForecastPipeline ≈ ENGINE_TIMEOUT + margen),
# si no Redis re-entrega el trabajo mientras aún se ejecuta.
REDIS_QUEUE_RETRY_AFTER=1020
# Conexión `redis-long` (el worker de imports/default arranca con ella): debe superar el $timeout más largo de
# importación, bridge, sincronización y exportación (3600 s).
REDIS_LONG_QUEUE_RETRY_AFTER=3700

FILESYSTEM_DISK=local

# Almacén Bronze (ADR-V25-04/08/24; docs/data/BRONZE_SILVER_GOLD.md): el original de cada carga, inmutable, antes de normalizar.
# PREDICTILY_BRONZE_DISK=local                 # local (desarrollo) | bronze_s3 (AWS S3 o un emulador S3)
# PREDICTILY_BRONZE_RETENTION_DAYS=0           # retención por defecto en días (0 = sin vencimiento); cada empresa fija la suya en settings.data.bronze_retention_days
# PREDICTILY_BRONZE_MAX_OBJECT_MB=64           # tamaño máximo de un objeto (acepta fracciones); una extracción SQL mayor detiene la captura
# Disco bronze_s3 (solo con PREDICTILY_BRONZE_DISK=bronze_s3). Sin clave/secreto se usa la cadena de credenciales del SDK (rol IAM): no los ponga aquí.
# PREDICTILY_BRONZE_S3_BUCKET=
# PREDICTILY_BRONZE_S3_REGION=us-east-1
# PREDICTILY_BRONZE_S3_ENDPOINT=               # solo emuladores (moto, MinIO)
# PREDICTILY_BRONZE_S3_PATH_STYLE=false        # true con emuladores
# PREDICTILY_BRONZE_S3_SSE=AES256              # cifrado del lado del servidor: AES256 (SSE-S3) | aws:kms
# PREDICTILY_BRONZE_S3_KMS_KEY_ID=             # con aws:kms
# PREDICTILY_BRONZE_S3_KEY=                    # solo sin rol IAM
# PREDICTILY_BRONZE_S3_SECRET=                 # solo sin rol IAM
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# SPA (Sanctum: cookies de sesión + CSRF). En producción usar el dominio real.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# Motor predictivo interno (FastAPI)
ENGINE_URL=http://127.0.0.1:8100
ENGINE_API_TOKEN=cambie-este-token-compartido
ENGINE_TIMEOUT=900
# Cola de los trabajos cortos del motor. Vacío = la misma que los largos (`forecasting`), que es lo que atiende `make dev-queue`.
# Si la define (p. ej. forecasting-light), arranque también un worker para ella.
ENGINE_LIGHT_QUEUE=
# Minutos tras los que una ejecución deja de bloquear una nueva: en curso (desde que empezó) y en cola (desde que se pidió).
ENGINE_STALE_RUN_MINUTES=120
ENGINE_STALE_QUEUED_MINUTES=240
# Cortacircuitos hacia el motor: tras ENGINE_CIRCUIT_FAILURES llamadas seguidas sin conectar se abre ENGINE_CIRCUIT_OPEN_SECONDS;
# mientras tanto los trabajos se aplazan (hasta ENGINE_CIRCUIT_MAX_DEFERRALS veces) en vez de gastar intentos.
ENGINE_CIRCUIT_ENABLED=true
ENGINE_CIRCUIT_FAILURES=3
ENGINE_CIRCUIT_OPEN_SECONDS=60
ENGINE_CIRCUIT_MAX_DEFERRALS=60
# Cola de los trabajos por empresa del ciclo diario (radar, decisiones, resultados). Vacío = `default`, que atiende `make dev-queue`.
# Si la define (p. ej. batch), arranque también un worker para ella.
PIPELINE_QUEUE=
# Directorio de artefactos de modelos del motor: la MISMA ruta/volumen que ENGINE_ARTIFACTS_DIR del motor (en Docker, el volumen
# engine-artifacts montado en solo lectura). El motor guarda model_registry.artifact_path relativo a este directorio; con él el backend
# verifica el SHA-256 al revertir modelos. Si se deja vacío, la reversión no verifica y lo informa (artifacts_verification).
ENGINE_ARTIFACTS_DIR=
# Firma Ed25519 de los artefactos de modelos (ADR-V25-20; config/engine.php). El backend SOLO verifica: nunca lleva claves privadas.
# Claves PÚBLICAS de confianza `kid:clave` (base64 de 32 bytes), separadas por comas: las mismas que ENGINE_TRUSTED_PUBLIC_KEYS del motor.
# Genere el par con `python -m predictily_engine.cli keygen` (ver docs/ml/MODEL_REGISTRY.md). Sin claves, ningún artefacto firmado se acepta.
# ENGINE_TRUSTED_PUBLIC_KEYS=
# Legado: acepta revertir a artefactos SIN firma (verificables solo por SHA-256). Solo en un entorno local; nunca acepta firmas inválidas.
# ENGINE_ALLOW_UNSIGNED_ARTIFACTS=false

# Superadministrador de plataforma (lo crea `php artisan db:seed`)
SUPERADMIN_EMAIL=admin@predictily.test
SUPERADMIN_PASSWORD=

# Predictily
PREDICTILY_DEFAULT_PLAN=trial
PREDICTILY_IMPORT_MAX_KB=20480
PREDICTILY_AUDIT_RETENTION_DAYS=730
# Tolerancia (minutos) de source_recorded_at posterior a «ahora» (desfase de reloj del origen). Una marca más futura no ordena
# versiones: se guarda NULL y se cuenta future_recorded_at (ADR-V25-23; docs/data/LINEAGE_AND_RECONCILIATION.md).
# PREDICTILY_RECORDED_AT_TOLERANCE_MINUTES=5
# Ruta de los datasets ficticios de demostración (por defecto ../data/demo)
# PREDICTILY_DEMO_PATH=/var/www/data/demo

# ── Etapa 2 ──────────────────────────────────────────────────────────────────
# Todas las variables siguientes son OPCIONALES (comentadas = valor por defecto de config/*.php). Sin valores reales: las claves
# solo se escriben en el .env del servidor, nunca en el repositorio.

# Asistente conversacional OPCIONAL (ADR-V2-12; config/conversation.php; docs/architecture/v2/P5b-plataforma.md §2.5).
# Explica resultados ya calculados con herramientas de lista blanca; nunca calcula cifras. Sin CONVERSATION_API_KEY queda desactivado
# (POST /api/v1/assistant/messages responde 503 assistant_disabled, sin llamadas de red) y los cuatro cores funcionan igual.
# CONVERSATION_ENABLED=true
# CONVERSATION_PROVIDER=ollama_cloud            # ollama_cloud | none
# CONVERSATION_BASE_URL=https://ollama.com
# CONVERSATION_API_KEY=
# CONVERSATION_MODEL=gpt-oss:120b               # verificar el catálogo vigente de la nube con soporte de herramientas
# CONVERSATION_TIMEOUT_SECONDS=30               # por llamada al proveedor
# CONVERSATION_CONNECT_TIMEOUT_SECONDS=5
# CONVERSATION_DEADLINE_SECONDS=45              # por mensaje completo (varias rondas de herramientas)
# CONVERSATION_MAX_MESSAGE_CHARS=1000
# CONVERSATION_MAX_OUTPUT_TOKENS=700
# CONVERSATION_TEMPERATURE=0.1
# CONVERSATION_RATE_PER_MINUTE=10               # por usuario
# CONVERSATION_DAILY_LIMIT=300                  # por empresa y día (0 = sin tope)
# CONVERSATION_CUSTOMER_TOOLS=true              # false: el asistente no consulta compradores (external_code)

# Conectores SQL de solo lectura (etapa 2 · P3; config/connectors.php; docs/07 §13). POLÍTICA ANTI-SSRF (ADR-V25-15), segura por defecto:
# solo nombres RFC 1123 o IP canónicas; se resuelven A y AAAA y la conexión usa la IP validada (sin DNS rebinding). Siempre denegados
# (ninguna lista los autoriza): metadatos de nube (169.254.0.0/16, fd00:ec2::254), link-local, 0.0.0.0/8, multicast y broadcast.
# Denegados por defecto: loopback y redes privadas (RFC 1918, 100.64.0.0/10, ULA fc00::/7); se autorizan SOLO con las listas siguientes.
# PREDICTILY_SQL_DENY_PRIVATE ya no existe (no hay modo «abierto»). Si PREDICTILY_SQL_ALLOWED_HOSTS no está vacía, solo se permiten esos destinos.
# Un NOMBRE de la lista solo conecta a una red privada si resuelve DENTRO de un CIDR de PREDICTILY_SQL_ALLOWED_CIDRS; una IP LITERAL de la lista
# se autoriza a sí misma. Metadatos y link-local siguen bloqueados siempre; el loopback nunca se autoriza en producción.
# PREDICTILY_SQL_ALLOWED_HOSTS=erp1.cliente.example,erp2.cliente.example   # nombres exactos o IP; en un SaaS multiempresa defínala siempre
# PREDICTILY_SQL_ALLOWED_CIDRS=10.20.0.0/16,fd00:1234::/48                 # redes privadas autorizadas (ERP en VPN); el loopback nunca en producción
# PREDICTILY_SQL_MAX_ROWS=2000000               # tope de filas por sincronización

# Endurecimiento de cargas XLSX (config/upload_safety.php; docs/07 §16): se inspecciona el ZIP antes de abrirlo (tamaños REALES descomprimidos,
# no los declarados). Los valores por defecto admiten el histórico real (99 334 líneas ≈ 10 MB en XLSX) y rechazan bombas de descompresión.
# PREDICTILY_XLSX_MAX_ENTRIES=1000
# PREDICTILY_XLSX_MAX_ENTRY_MB=512                # descomprimido, por entrada
# PREDICTILY_XLSX_MAX_TOTAL_MB=1024               # descomprimido, en total
# PREDICTILY_XLSX_MAX_SHARED_STRINGS_MB=32        # cadenas compartidas y estilos (la parte a la que apunta la relación, con cualquier nombre)
# PREDICTILY_XLSX_MAX_RATIO=100                   # razón descomprimido/comprimido máxima
# PREDICTILY_XLSX_MAX_COLUMNS=500                 # columnas de la fila de encabezados y de la vista previa
# PREDICTILY_XLSX_ANALYSIS_MAX_SCANNED_ROWS=20000 # filas recorridas (también vacías) hasta hallar encabezados y vista previa
# PREDICTILY_XLSX_ANALYSIS_MAX_SHEET_MB=8         # bytes de la hoja que el lector puede consumir antes de entregar las primeras filas (ventana interactiva)
# PREDICTILY_XLSX_ANALYSIS_TIMEOUT=10             # segundos de TODA la ventana interactiva: apertura del libro + encabezados + vista previa (no rige la cola)

# Factor Intelligence (config/intelligence.php; docs/intelligence/FACTOR_INTELLIGENCE.md §8): contrato de pronósticos compartidos entre empresas
# autorizadas (V2.1 §10). DESACTIVADO en P0: con false todas sus rutas responden 404. No lo active sin la decisión de habilitar la red colaborativa.
# PREDICTILY_SHARED_FORECAST_GRANTS_ENABLED=false
